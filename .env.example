# ==============================================================================
# Blood Donor Platform - Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to .env:  cp .env.example .env
# Production Domain: https://bloodaid.scripthorizon.tech
# Supports multiple API versions (/v1, /v2, etc.) and unversioned auth (/auth)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Project & Environment Mode
# ------------------------------------------------------------------------------
PROJECT_NAME="Blood Aid"
NODE_ENV=production


# ------------------------------------------------------------------------------
# 2. PostgreSQL + PostGIS Database (Internal Docker Network)
# ------------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=blood_platform


# ------------------------------------------------------------------------------
# 3. Redis Cache & Queue (Internal Docker Network)
# ------------------------------------------------------------------------------
REDIS_PASSWORD=redispassword


# ------------------------------------------------------------------------------
# 4. Backend API Service Configuration
# ------------------------------------------------------------------------------
PORT=3001
API_PORT=3001
MIGRATIONS_RUN=true
ADMIN_EMAIL=ahamed.hossain@rpsu.edu.bd

JWT_ACCESS_SECRET=jwt_super_secret_access_key_blood_aid_platform_32bytes_min
JWT_ACCESS_EXPIRES_IN=30d
JWT_REFRESH_SECRET=jwt_super_secret_refresh_key_blood_aid_platform_32bytes_min
JWT_REFRESH_EXPIRES_IN=30d

# Allowed frontend origin for CORS browser requests
# Production: https://bloodaid.scripthorizon.tech
# Local: http://localhost:3000
CORS_ORIGIN=https://bloodaid.scripthorizon.tech


# ------------------------------------------------------------------------------
# 5. Google OAuth 2.0 Authentication (Unversioned Callback)
# ------------------------------------------------------------------------------
# From Google Cloud Console:
GOOGLE_CLIENT_ID=631641086229-uhss2d2elmmouho1tsjps9ec0l1jprtp.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Redirect callback URL (WITHOUT /v1 version prefix, as configured in Google Console):
# Production: https://bloodaid.scripthorizon.tech/auth/google/callback
# Local: http://localhost:3001/auth/google/callback
GOOGLE_CALLBACK_URL=https://bloodaid.scripthorizon.tech/auth/google/callback


# ------------------------------------------------------------------------------
# 6. Web Push Notifications (VAPID Keys)
# ------------------------------------------------------------------------------
VAPID_PUBLIC_KEY=BKbTTtB8DyaT2HZPNcmdYP0VgqRcxnFnzp_biZ6PVa1Q3QQvrMl6dTXCaM2EV89Vmy_HKYZP-Lus8xK5MuH7Pyo
VAPID_PRIVATE_KEY=7l0jout8mKB4DigtZSVvG07dl5kaEnkhhdOM3Y0ScoI


# ------------------------------------------------------------------------------
# 7. Frontend Web Application (Next.js)
# ------------------------------------------------------------------------------
WEB_PORT=3000

# Public URL of the platform used by browser
# Production: https://bloodaid.scripthorizon.tech
# Local: http://localhost:3000
NEXT_PUBLIC_API_URL=https://bloodaid.scripthorizon.tech
NEXT_PUBLIC_API_VERSION=v1

NEXT_PUBLIC_PROJECT_NAME="Blood Aid"
NEXT_PUBLIC_VAPID_PUBLIC_KEY=BKbTTtB8DyaT2HZPNcmdYP0VgqRcxnFnzp_biZ6PVa1Q3QQvrMl6dTXCaM2EV89Vmy_HKYZP-Lus8xK5MuH7Pyo

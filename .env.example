# ==============================================================================
# Environment Configuration for Blood Donor Platform
# All variables are required. Do NOT leave blank.
# ==============================================================================

# Project & Node Environment
PROJECT_NAME="Blood Aid"
NODE_ENV=production

# Database Configuration (Internal Docker Network)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=blood_platform

# Redis Configuration (Internal Docker Network)
REDIS_PASSWORD=redispassword

# API Service Configuration
PORT=3001
API_PORT=3001
JWT_ACCESS_SECRET=jwt_super_secret_access_key_blood_aid_platform
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=jwt_super_secret_refresh_key_blood_aid_platform
JWT_REFRESH_EXPIRES_IN=30d
GOOGLE_CLIENT_ID=dummy-client-id
GOOGLE_CLIENT_SECRET=dummy-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3001/v1/auth/google/callback
CORS_ORIGIN=http://localhost:3000
MIGRATIONS_RUN=true


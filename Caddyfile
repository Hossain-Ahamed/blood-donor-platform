# Replace example.com with your actual domain name
example.com {
    # Reverse proxy API requests under /v1 to the api service
    handle /v1* {
        reverse_proxy api:3001
    }

    # Reverse proxy Swagger documentation
    handle /api/docs* {
        reverse_proxy api:3001
    }

    # Reverse proxy Next.js web application
    handle {
        reverse_proxy web:3000
    }
}
